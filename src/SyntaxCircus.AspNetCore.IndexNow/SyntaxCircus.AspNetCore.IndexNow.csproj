<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>SyntaxCircus.AspNetCore.IndexNow</PackageId>
    <Title>SyntaxCircus ASP.NET Core IndexNow</Title>
    <Description>Ownership verification, sitemap previews, and explicit IndexNow URL submission for ASP.NET Core.</Description>
    <Authors>Syntax Circus LLC</Authors>
    <Company>Syntax Circus LLC</Company>
    <PackageTags>aspnetcore;indexnow;seo;sitemap</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Syntax-Circus/SyntaxCircus.AspNetCore.IndexNow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Syntax-Circus/SyntaxCircus.AspNetCore.IndexNow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="GitVersion.MsBuild" PrivateAssets="all" />
    <InternalsVisibleTo Include="SyntaxCircus.AspNetCore.IndexNow.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
